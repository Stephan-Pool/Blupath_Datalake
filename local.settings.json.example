{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "BLUPATH_BASE_URL": "https://api.blupath.example",
    "BLUPATH_LOADS_PATH": "/v1/loads",
    "BLUPATH_AUTH_TYPE": "bearer",
    "BLUPATH_API_KEY": "<from Key Vault in Azure>",
    "BLUPATH_FROM_PARAM": "updatedFrom",
    "BLUPATH_TO_PARAM": "updatedTo",
    "BLUPATH_DATE_FORMAT": "iso",
    "BLUPATH_PAGINATION": "page",
    "BLUPATH_PAGE_PARAM": "page",
    "BLUPATH_PAGE_SIZE_PARAM": "pageSize",
    "BLUPATH_PAGE_SIZE": "500",
    "BLUPATH_RECORDS_KEY": "data",
    "BLUPATH_ID_FIELD": "id",

    "SP_TENANT_ID": "<azure tenant id>",
    "SP_CLIENT_ID": "<app registration client id>",
    "SP_CLIENT_SECRET": "<from Key Vault in Azure>",
    "SP_HOSTNAME": "yourcompany.sharepoint.com",
    "SP_SITE_PATH": "/sites/DataLake",
    "SP_DRIVE_NAME": "Documents",
    "SP_ROOT_FOLDER": "Blupath Data Lake"
  }
}
